module Traffic
(
    input logic clk, // 1 Hz clk
    input logic rst,
    input logic TAORB, // traffic on A = 1 or on B =0 
    output reg [5:0] led //light bits 
);

typedef enum bit [1:0] 
{
    GREENRED = 2'b00,   
    YELLOWRED = 2'b01,  
    REDGREEN = 2'b10,   
    REDYELLOW = 2'b11   
} state_t;

state_t state_reg, state_next;

// Timer variables
reg [2:0] timer_count;  
reg timer_reset;

// Timer logic - counts seconds when enabled
always @(posedge clk or posedge rst) begin
    if (rst) begin
        timer_count <= 0;
    end else begin
        if (timer_reset) begin
            timer_count <= 0;
	end
        else if ((state_reg == YELLOWRED || state_reg == REDYELLOW) && timer_count <5) begin
		timer_count <= timer_count + 1;
        end
        // When timer_count = 5, it stops counting
    end
end


// Sequential logic for state transition
always_ff @(posedge clk or posedge rst) begin
    if (rst) 
        state_reg <= GREENRED;  // Reset to initial state
    else 
        state_reg <= state_next;
end

// Added Timer using Timer logic
always_comb begin
    
    state_next = state_reg;
    timer_reset = 0;
    
    case (state_reg)
        GREENRED: begin  
            led = 6'b001100; 
            if (!TAORB) begin
                state_next = YELLOWRED;
                timer_reset = 1; // Reset timer when entering YELLOWRED
            end else begin
                state_next = GREENRED;
            end
        end

        YELLOWRED: begin  
            led = 6'b010100; 
            
            
         if (timer_count ==5) begin
		state_next = REDGREEN;
		timer_reset = 1;
	end
	else
		state_next = YELLOWRED;
	end

        REDGREEN: begin  
            led = 6'b100001; 
            if (TAORB) begin
                state_next = REDYELLOW;
                timer_reset = 1; // Reset timer when entering REDYELLOW
            end else begin
                state_next = REDGREEN;
            end
        end

        REDYELLOW: begin  // S3 in diagram - needs 5 second timer
            led = 6'b100010; // A=Red, B=Yellow
            
            // Check timer conditions based on diagram
            if (TAORB) begin
                if (timer_count < 5) begin
                    state_next = REDYELLOW; // Stay here while timer <5
                end else if (timer_count == 5) begin
                    state_next = GREENRED;   // Go to S0 when timer=5
                    timer_reset = 1;          // Reset timer
                end
            end else begin
                // If TAORB becomes false during this state
                state_next = GREENRED; // Assuming direct transition
                timer_reset = 1;
            end
        end

        default: state_next = GREENRED; 
    endcase
end

endmodule

// Half-second to 1Hz converter 
module halfsecond(
    input logic clk_100MHz,
    input logic reset,
    output logic clk_halfsec
);
    
    logic [25:0] r_count = 0; 
    logic r_half = 0; 

    always_ff @(posedge clk_100MHz or posedge reset) begin       
        if(reset)
            r_count <= 26'b0;
        else
            if(r_count == 49_999) //Here choose 49999999(50e6-1)/100e6 seconds for an edge
		begin
                r_count <= 26'b0;
                r_half <= ~r_half;
            end
            else 
                r_count <= r_count + 1;
    end
    
    assign clk_halfsec = r_half;
    
endmodule

// Top module 
module Traffic_top(
    input logic clk_100MHz,
    input logic TAORB,
    input logic reset,
    output logic [5:0] led
);
    
    wire w_1Hz;
    
    Traffic r4(
        .clk(w_1Hz),
        .rst(reset),
        .TAORB(TAORB),
        .led(led)
    );

    halfsecond uno (
        .clk_100MHz(clk_100MHz),
        .reset(reset),
        .clk_halfsec(w_1Hz)
    );

endmodule